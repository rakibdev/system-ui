{"patch", "./template ./target", "Find & replace variables."},


if (args[0] == "patch") {
  if (args.size() != 3) {
    Log::error("Invalid amount of arguments.");
    return 1;
  }
  std::string error;
  patch(args[1], args[2], error);
  if (error.empty())
    return 0;
  else {
    Log::error(error);
    return 1;
  }
}

std::string command;
std::vector<std::string> args;
for (int i = 1; i < argc; i++) {
  if (i > 1) command += " ";
  command += argv[i];
  args.push_back(argv[i]);
}
