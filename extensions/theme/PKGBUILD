pkgname=system-ui-theme
pkgver=1.0.0
pkgrel=1
pkgdesc="Material 3 theme generator"
arch=('x86_64')
license=('MPL-2.0')
depends=('cairo' 'libwebp' 'libjpeg-turbo' 'librsvg')
makedepends=('xmake')

build() {
    cd "$startdir"
    xmake config --mode=release
    xmake build theme
}

package() {
    cd "$startdir"
    install -Dm755 ../../build/theme "$pkgdir/usr/bin/theme"
}